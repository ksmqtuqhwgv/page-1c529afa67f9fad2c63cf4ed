x;font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--violet-deep);border:1px dashed var(--violet);padding:3px 8px;border-radius:2px}\n\n/* 仪表盘式数据块拼贴 */\n.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin:18px 0 8px}\n.kpi{background:var(--paper);border:1px dashed var(--dash);padding:18px 16px}\n.kpi b{display:block;font-size:28px;font-weight:800;letter-spacing:-.01em;color:var(--violet-deep)}\n.kpi span{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted)}\n\n/* 杂志式多栏网格 */\n.grid-2{display:grid;grid-template-columns:1.1fr .9fr;gap:28px}\n.note{background:var(--violet-soft);border-left:4px solid var(--violet);padding:16px 18px;color:#3b256e;font-size:14.5px}\n\n/* FAQ details */\n.faq-list{display:grid;gap:12px}\ndetails{background:var(--paper);border:1px dashed var(--dash);border-radius:4px;padding:14px 18px}\ndetails[open]{background:#fbf9ff}\nsummary{cursor:pointer;font-weight:600;list-style:none;display:flex;justify-content:space-between;align-items:center;gap:16px}\nsummary::-webkit-details-marker{display:none}\nsummary::after{content:\"+\";font-family:\"SF Mono\",monospace;color:var(--violet-deep);font-size:18px;line-height:1}\ndetails[open] summary::after{content:\"−\"}\n.faq-body{margin-top:10px;color:var(--muted);font-size:14.5px;border-top:1px dashed var(--line);padding-top:10px}\n.faq-body p{margin:6px 0}\n.faq-topic{margin:32px 0 10px;font-size:14px;letter-spacing:.18em;text-transform:uppercase;color:var(--violet-deep)}\n\n/* 客户端区块 */\n.clients{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}\n.client{background:var(--paper);border:1px dashed var(--dash);padding:18px}\n.client h3{margin:0 0 6px;font-size:17px}\n.client p{margin:0 0 10px;color:var(--muted);font-size:14px}\n.client .meta{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);border-top:1px dashed var(--line);padding-top:10px}\n\n/* 步骤 */\n.steps{counter-reset:step;list-style:none;padding:0;margin:0;display:grid;gap:12px}\n.steps li{background:var(--paper);border:1px dashed var(--dash);padding:16px 18px 16px 64px;position:relative}\n.steps li::before{counter-increment:step;content:counter(step,decimal-leading-zero);position:absolute;left:18px;top:14px;font-family:\"SF Mono\",monospace;color:var(--violet-deep);font-weight:700;font-size:20px}\n\nfooter{border-top:1px dashed var(--line);background:var(--paper);padding:28px 0;color:var(--muted);font-size:13px}\nfooter .row{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}\n\n@media (max-width:760px){\n  h1.brand{font-size:48px}\n  .band-b{min-height:200px;padding:36px 24px}\n  .kpis{grid-template-columns:repeat(2,1fr)}\n  .grid-2{grid-template-columns:1fr}\n  .clients{grid-template-columns:1fr}\n  section{margin:48px 0}\n  .ticket::before,.ticket::after{display:none}\n  .ticket .stamp{position:static;display:inline-block;margin-bottom:8px}\n}\n</style><header class=\"hero\">\n  <div class=\"band band-a\">\n    <div class=\"wrap\">\n      <div class=\"brand-mark\">Pikap<small>Prywatny zestaw subskrypcji</small></div>\n      <div class=\"hero-meta\"><span>订阅档案 · <b>#3863</b></span><span>清单体例 · v1</span></div>\n    </div>\n  </div>\n  <div class=\"band band-b\">\n    <div class=\"wrap\">\n      <p class=\"eyebrow\">Subskrypcja sieciowa · 订阅索引</p>\n      <h1 class=\"brand\">Pikap<span>把每一档订阅、每一项权益，写成可以勾选的清单。</span></h1>\n      <ul class=\"tagrow\">\n        <li>虚线票据</li>\n        <li>三档分层</li>\n        <li>清单式计费</li>\n        <li>FAQ 折叠</li>\n        <li>无导航跳转</li>\n      </ul>\n    </div>\n  </div>\n  <div class=\"band band-c\">\n    <div class=\"wrap\">\n      <div class=\"hero-jump\">\n        <a href=\"#archive\">套餐 &amp; 价格</a>\n        <a href=\"#specs\">规格对照</a>\n        <a href=\"#usage\">使用步骤</a>\n        <a href=\"#clients\">客户端清单</a>\n        <a href=\"#faq\">常见问题</a>\n      </div>\n      <div>往下滚动 · 逐项查阅</div>\n    </div>\n  </div>\n  <div class=\"band band-d\">\n    <div class=\"wrap\">\n      <div>Pikap 订阅档案 · 月付与年付并行 · 不绑定自动续费</div>\n      <div>最近整理 · 文档版次 1.0</div>\n    </div>\n  </div>\n</header>\n\n<main>\n  <div class=\"wrap\">\n\n    <nav class=\"toc\" aria-label=\"区块跳转\">\n      <a href=\"#archive\">01 套餐与价格</a>\n      <a href=\"#specs\">02 规格对照</a>\n      <a href=\"#usage\">03 使用步骤</a>\n      <a href=\"#clients\">04 客户端清单</a>\n      <a href=\"#notes\">05 备注与限制</a>\n      <a href=\"#faq\">06 常见问题</a>\n    </nav>\n\n    <section id=\"archive\">\n      <h2><small>01 / Archive</small>套餐与价格</h2>\n      <p class=\"lead\">三档订阅按月或按年计费，价格与流量配额逐项写明，下方票据卡片按从基础到团队的顺序堆叠，对照阅读即可。</p>\n\n      <div class=\"ticket\">\n        <span class=\"stamp\">基础</span>\n        <div class=\"head\">\n          <div class=\"name\">基础版</div>\n          <div class=\"price\">¥15/月<small>按年付仅需 ¥150/年</small></div>\n        </div>\n        <ul>\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n      </div>\n\n      <div class=\"ticket\">\n        <span class=\"stamp\">推荐</span>\n        <div class=\"head\">\n          <div class=\"name\">旗舰版</div>\n          <div class=\"price\">¥35/月<small>按年付仅需 ¥350/年</small></div>\n        </div>\n        <ul>\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n      </div>\n\n      <div class=\"ticket\">\n        <span class=\"stamp\">团队</span>\n        <div class=\"head\">\n          <div class=\"name\">团队版</div>\n          <div class=\"price\">¥85/月<small>按年付仅需 ¥850/年</small></div>\n        </div>\n        <ul>\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n      </div>\n    </section>\n\n    <section id=\"specs\">\n      <h2><small>02 / Specyfikacje</small>规格对照</h2>\n      <p class=\"lead\">将关键规格抽成仪表盘式的数据块，便于在三档之间快速比对。</p>\n      <div class=\"kpis\">\n        <div class=\"kpi\"><span>最低月付</span><b>¥15</b></div>\n        <div class=\"kpi\"><span>最高月流量</span><b>1000GB</b></div>\n        <div class=\"kpi\"><span>最多设备</span><b>20 台</b></div>\n        <div class=\"kpi\"><span>计费周期</span><b>月 / 年</b></div>\n      </div>\n      <div class=\"grid-2\">\n        <div class=\"note\">\n          计费说明：月付与年付均为预付方式，年付按 10 个月价格计费，写入票据价格的“按年付仅需”字段；中途升级档位按剩余天数折算差额。\n        </div>\n        <div class=\"note\">\n          流量计算：每档配额在自然月内重置，未使用流量不结转；流媒体解锁、专线优化等权益随档位提升逐级开放。\n        </div>\n      </div>\n    </section>\n\n    <section id=\"usage\">\n      <h2><small>03 / Jak zacząć</small>使用步骤</h2>\n      <p class=\"lead\">从下单到连接，按顺序列出五个步骤；每一步只做一件事，便于复制到内部 SOP。</p>\n      <ol class=\"steps\">\n        <li>在“套餐与价格”区块选择基础、旗舰或团队三档之一，确认月付或年付。</li>\n        <li>提交订单后，在订阅档案中获取订阅链接与端口信息，记录于个人保管处。</li>\n        <li>在设备上安装兼容的客户端，导入订阅链接或手动填入服务器地址。</li>\n        <li>客户端内选择节点并启用连接，首次连接请放行系统网络权限请求。</li>\n        <li>连接成功后访问任意站点验证连通性，若失败可进入“常见问题”逐条排查。</li>\n      </ol>\n    </section>\n\n    <section id=\"clients\">\n      <h2><small>04 / Klienci</small>客户端清单</h2>\n      <p class=\"lead\">未提供官方客户端下载地址时，请按所在平台选择通用代理工具并手动填入订阅信息；下方列出常见兼容方向。</p>\n      <div class=\"clients\">\n        <div class=\"client\">\n          <h3>桌面 · Windows / macOS</h3>\n          <p>使用支持订阅导入的代理客户端，将 Pikap 提供的订阅链接粘贴至订阅管理页。</p>\n          <div class=\"meta\">系统：Windows 10+ · macOS 11+</div>\n        </div>\n        <div class=\"client\">\n          <h3>移动 · iOS / Android</h3>\n          <p>在 App Store 或应用市场安装对应客户端，扫描订阅二维码或粘贴订阅链接完成导入。</p>\n          <div class=\"meta\">系统：iOS 15+ · Android 9+</div>\n        </div>\n        <div class=\"client\">\n          <h3>命令行 · Linux / 路由器</h3>\n          <p>在终端或路由器管理界面填入服务器地址、端口、密码与加密方式，手动同步节点配置。</p>\n          <div class=\"meta\">系统：主流 Linux 发行版 · OpenWrt</div>\n        </div>\n      </div>\n      <p>未在事实表中提供官方下载来源，相关地址请以订阅档案内的指引为准。</p>\n    </section>\n\n    <section id=\"notes\">\n      <h2><small>05 / Uwagi</small>备注与限制</h2>\n      <p class=\"lead\">把适用范围、计费边界与变更记录写成一组短条目，便于订阅前查阅。</p>\n      <ul>\n        <li>所有套餐价格与流量配额仅在订阅档案有效期内生效，调整前会以票据头部形式提示。</li>\n        <li>设备数限制按同时在线连接计算，同一账号在超出限制时新连接将替代最旧连接。</li>\n        <li>年付订单在到期前 7 天可选择续费或降档，到期后未续费将自动停止服务。</li>\n        <li>本档案不包含退款细则、节点性能数据或第三方测评结论，请以订阅档案更新为准。</li>\n      </ul>\n    </section>\n\n    <section id=\"faq\">\n      <h2><small>06 / FAQ</small>常见问题</h2>\n      <p class=\"lead\">按主题分组列出 FAQ，全部以折叠形式呈现，问题与答案逐条对应。</p>\n\n      <div class=\"faq-topic\">订阅与计费</div>\n      <div class=\"faq-list\">\n        <details>\n          <summary>基础版、旗舰版、团队版的核心差别是什么？</summary>\n          <div class=\"faq-body\"><p>差别集中在每月流量、设备数与节点能力上：基础版提供 100GB 与 3 台设备，旗舰版提升至 300GB 与 5 台并加入 IPLC 专线，团队版面向多设备场景，提供 1000GB 与 20 台。</p></div>\n        </details>\n        <details>\n          <summary>月付与年付的换算关系是什么？</summary>\n          <div class=\"faq-body\"><p>年付按 10 个月价格计费，写入票据卡片“按年付仅需”字段；月付与年付均为预付，年付订单在到期前可续费或降档。</p></div>\n        </details>\n        <details>\n          <summary>升级或降档后如何结算差价？</summary>\n          <div class=\"faq-body\"><p>升级按剩余天数折算差额并在下一周期统一结算；降档在当前周期结束后生效，避免中途扣费。</p></div>\n        </details>\n      </div>\n\n      <div class=\"faq-topic\">流量与节点</div>\n      <div class=\"faq-list\">\n        <details>\n          <summary>每月流量用完后会怎样？</summary>\n          <div class=\"faq-body\"><p>自然月内配额耗尽后，连接会被暂停至下个账期重置；未使用流量不结转。</p></div>\n        </details>\n        <details>\n          <summary>节点池与专线节点有何区别？</summary>\n          <div class=\"faq-body\"><p>普通线路节点池面向基础版与日常浏览；IPLC 专线面向游戏与低延迟场景，仅旗舰版及以上开放。</p></div>\n        </details>\n        <details>\n          <summary>设备数限制是按账号还是按设备？</summary>\n          <div class=\"faq-body\"><p>按同一账号同时在线的设备数计算；超出时新连接将替代最旧连接。</p></div>\n        </details>\n      </div>\n\n      <div class=\"faq-topic\">客户端与使用</div>\n      <div class=\"faq-list\">\n        <details>\n          <summary>订阅链接在哪里查看？</summary>\n          <div class=\"faq-body\"><p>在订阅档案中查看，或复制对应的订阅链接与端口信息；请勿将链接公开发布。</p></div>\n        </details>\n        <details>\n          <summary>如何在客户端中导入订阅？</summary>\n          <div class=\"faq-body\"><p>在客户端的订阅管理页粘贴订阅链接，或扫描订阅二维码；首次连接请放行系统网络权限请求。</p></div>\n        </details>\n        <details>\n          <summary>连接失败时如何排查？</summary>\n          <div class=\"faq-body\"><p>先核对订阅链接是否过期，再确认本机时间与时区，最后切换至其他节点重试；若仍异常可进入订阅档案提交工单。</p></div>\n        </details>\n      </div>\n\n      <div class=\"faq-topic\">合规与档案</div>\n      <div class=\"faq-list\">\n        <details>\n          <summary>本档案会更新吗？</summary>\n          <div class=\"faq-body\"><p>会。价格、流量配额与权益调整会以票据头部与本档案版本号形式提示。</p></div>\n        </details>\n        <details>\n          <summary>档案内没有提到的内容怎么办？</summary>\n          <div class=\"faq-body\"><p>未写入档案的内容视为暂无可靠信息，请勿据此推断官方承诺；具体以订阅档案更新为准。</p></div>\n        </details>\n      </div>\n    </section>\n\n  </div>\n</main>\n\n<footer>\n  <div class=\"wrap row\">\n    <div>© Pikap · 订阅清单档案 · 仅供查阅</div>\n    <div>档案编号 #3863 · 虚线票据版式 · 无导航跳转</div>\n  </div>\n</footer>",
